# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# PocketBase CMS address used by the web server for API calls.
# Dynamic: resolved when the server boots, so each deployment can set it at runtime.
# @public @dynamic @type=url
POCKETBASE_URL=http://127.0.0.1:8090

# PocketBase address reachable from visitors' browsers (uploaded images and files).
# @public @dynamic @type=url
POCKETBASE_PUBLIC_URL=http://127.0.0.1:8090
